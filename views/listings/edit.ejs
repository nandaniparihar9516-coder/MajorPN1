<% layout("/layouts/boilerplate")%>
<div class="row  mt-3">
    <div class="col-8 offset-2">


    <h3>Edit Your Listing</h3>
    <form method="POST" 
    action="/listings/<%= listing._id%>?_method=PUT" 
        class="needs-validation" novalidate
        enctype="multipart/form-data">
<div class="mb-3">
    <lable for="title" class="form-lable">Title</lable>
     <input name="listing[title]" value="<%=listing.title%>"  required class="form-control" type="text">
   <div class="valid-feedback"> Title Looks Nice</div>
    </div>
       
        <div class="mb-3">
    <lable for="description" class="form-lable">Description</lable>
        <textarea name="listing[description]"  required class="form-control"><%= listing.description %> </textarea>
    
 <div class="invalid-feedback">Please enter a short Description</div>
    </div>

    <div class="mb-3">
        Original Listing Image<br>
        <img src="<%=originalImageUrl%>" />
    </div>
    
        <div class="mb-3">
    <lable for="image" class="form-lable">Upload New Image</lable>
        <input name="listing[image]" 
         class="form-control"  
      type="file">
  
        </div> 
    
      
            <div class="row">
       <div class="mb-3 col-md-4">
    <lable for="price" class="form-lable">Price</lable>
        <input name="listing[price]"  required class="form-control" value="<%=listing.price%>" type="text">
<div class="invalid-feedback"> Price should be valid</div>
    </div>
<div class="mb-3 col-md-4">
    <lable for="country" class="form-lable">Country</lable>
        <input name="listing[country]"  class="form-control"  required value="<%=listing.country%>" type="text">
  <div class="invalid-feedback">Country should be valid</div>
    </div>
    <div class="mb-3 col-md-4">
    <label for="category" class="form-label">Category </label>
 <% const cates = ['Trending','Farms', 'Rooms','Iconic Cities','Mountains Cities', 'Castles', 'Amazing Pools', 'Camping', 'Arctic', 'Domes', 'Boats']; %>
<select name="listing[category]" class="form-control" required>
     <% for(let cate of cates){ %>
    <option value="<%= cate%>" <%=listing.category===cate ? "selected" : "" %>> <%=cate %> 
    </option>
    <% } %>
</select>

      <div class="invalid-feedback">Category should be valid</div>
</div>
<div class="mb-3">
    <lable for="location" class="form-lable">Location</lable>       
<input name="listing[location]"   class="form-control" required  value="<%=listing.location%>" type="text">
    <div class="invalid-feedback">Location should be valid</div>   
    </div>
   
    <button class="btn btn-dark edit-btn mt-3">Edit</button>
    <br></br>
        <br>
        </form>
      
</div>
</div>
