<% layout("/layouts/boilerplate")%>
<div class="row mt-3">
<div class="col-8 offset-2">
    <h3>Add New Listing</h3>
    <br></br>
    <form method="POST" action="/listings" 
     enctype="multipart/form-data" class=" needs-validation" novalidate>
        <div class="mb-3">
            <lable for="title" class="form-lable"> Title</lable>
        <input name="listing[title]" placeholder="Add a catchy  title" 
        type="text" class="form-control" required>
          <div class="valid-feedback"> Title Looks Nice</div>
        </div>

     <div class="mb-3">
         <lable for="description"  class="form-lable">Description</lable>
<textarea name="listing[description]"
class="form-control" required></textarea>
  <div class="invalid-feedback">Please enter a short Description</div>
     </div>

<div class="mb-3">
      <lable for="image" class="form-lable">Upload Listing Image</lable>
    <input name="listing[image]" 
    type="file" class="form-control"  required>
</div>

<div class="row">
       <div class="mb-3 col-md-4">
          <lable for="price" class="form-lable">Price</lable>
          <input name="listing[price]" type="text"
          placeholder="1200"  required class="form-control" >
          <div class="invalid-feedback"> Price should be valid</div>
       </div>
      
        <div class="mb-3 col-md-8">
              <lable for="country" class="form-lable">Country</lable>
               <input name="listing[country]"  required placeholder="India " class="form-control">
    <div class="invalid-feedback">Country should be valid</div>
            </div>       
            <div class="mb-3 col-md-8">
     <label for="category" class="form-label">Category </label>
   <% const cates = ['Trending','Farms', 'Rooms','Iconic Cities','Mountains Cities', 'Castles', 'Amazing Pools', 'Camping', 'Arctic', 'Domes', 'Boats']; %>
<select name="listing[category]" class="form-select" required>
     <% for(let cate of cates){ %>
    <option value="<%= cate%>" > <%=cate %> 
    </option>
    <% } %>
</select>


      <div class="invalid-feedback">Category should be valid</div>

</div> 
       </div>
       <div class="mb-3">
          <lable for="location" class="form-lable">Location</lable>
        <input name="listing[location]" placeholder="jaipur ,Rajsthan"  required class="form-control">
    <div class="invalid-feedback">Location should be valid</div>   
    </div>
        
        
        <button class="btn btn-dark  mt-3 add-btn">Add </button>
        <br></br>
        <br>
        </form>
</div>
</div>
