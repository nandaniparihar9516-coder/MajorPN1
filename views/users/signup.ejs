<% layout("/layouts/boilerplate")%>

<div class="row mt-3">
    <h1 class="col-6 offset-3">SignUp on Wanderlust</h1>
<div class="col-6 offset-3">
    <form action="/signup" method="POST">
        <div class="mb-3">
            <lable for="username" class="form-lable"> 
                username</lable>
        <input name="username" 
       id="username"
        type="text" class="form-control"  class="needs-validation" novalidate
        required>
          <div class="valid-feedback">
            Looks Nice</div>
        </div>


         <div class="mb-3">
            <lable for="email" class="form-lable"> 
                Email</lable>
        <input name="email" 
       id="email"
        type="email" class="form-control"  class="needs-validation"
         novalidate
        required>
          
        </div>

         <div class="mb-3">
            <lable for="password" class="form-lable"> 
                Password</lable>
        <input name="password" 
       id="password"
        type="password" class="form-control" 
         class="needs-validation" novalidate
        required>
         
</div>
<button class="btn btn-success">SignUp</button>
    </form>
    </div>
    </div>